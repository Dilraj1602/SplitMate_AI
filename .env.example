
# Database connection
DATABASE_URL=postgresql+psycopg://splitmate_app:CHANGE_ME@localhost:5432/splitmate_ai

# Groq API key (needed later for AI features)
GROQ_API_KEY=your_groq_api_key_here

# LangSmith tracing (optional; configure later)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=splitmate-ai

# Comma-separated browser origins allowed by the API
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
ENVIRONMENT=development

# Brevo transactional email (configure locally; never commit .env)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=wolfstrix360@gmail.com
BREVO_SENDER_NAME=SplitMateAi

# Authentication and one-time code settings
SECRET_KEY=replace_with_a_long_random_secret
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Local-only OTP testing. Keep disabled in normal and production environments.
DEV_OTP_BYPASS=false
DEV_OTP_CODE=
