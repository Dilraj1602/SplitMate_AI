
# Database connection
DATABASE_URL=postgresql+psycopg://splitmate_app:CHANGE_ME@localhost:5432/splitmate_ai

# Optional legacy Groq setting; AI automation currently uses local Ollama.
GROQ_API_KEY=your_groq_api_key_here

# Local AI automation
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
WHISPER_MODEL=tiny

# LangSmith tracing (optional; configure later)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=splitmate-ai

# Comma-separated browser origins allowed by the API
CORS_ORIGINS=
FRONTEND_BASE_URL=http://localhost:5173

ENVIRONMENT=development

# Brevo transactional email (configure locally; never commit .env)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=SplitMate AI

# Authentication and one-time code settings
SECRET_KEY=replace_with_a_long_random_secret
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Local-only OTP testing. Keep disabled in normal and production environments.
DEV_OTP_BYPASS=false
DEV_OTP_CODE=
